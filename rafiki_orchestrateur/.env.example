# LM Studio doit être lancé avec le serveur local activé.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm_studio
# Mets ici exactement le nom affiché dans LM Studio si différent.
LMSTUDIO_MODEL=gemma-3n-4b

# Mode de test PC avant Raspberry Pi.
RAFIKI_MODE=simulation
RAFIKI_CHILD_ID=default
RAFIKI_DB_PATH=./rafiki_memory.sqlite3

# MQTT: pour test PC, laisse disabled. Sur Raspberry, passe à true et lance Mosquitto.
RAFIKI_MQTT_ENABLED=false
RAFIKI_MQTT_BROKER=localhost
RAFIKI_MQTT_PORT=1883
RAFIKI_MQTT_TOPIC_COMMANDS=rafiki/esp32/commands
RAFIKI_MQTT_TOPIC_STATUS=rafiki/esp32/status

# Cloud fallback désactivé par défaut pour respecter le local-first.
RAFIKI_CLOUD_ENABLED=false
RAFIKI_CLOUD_API_URL=http://127.0.0.1:8000
